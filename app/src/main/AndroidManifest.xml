<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.geminiapp.chat">

    <uses-sdk android:minSdkVersion="1" android:targetSdkVersion="31" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Автообновление: установка скачанного APK (нужно с Android 8) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SetupLanguageActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SetupUpdateActivity" />
        <activity android:name=".SetupApiKeyActivity" />
        <activity android:name=".MainActivity" />
        <activity android:name=".SettingsActivity" />
        <activity android:name=".ChatHistoryActivity" />

        <!-- Отдаёт установщику скачанный APK обновления (Android 7+) -->
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="com.geminiapp.chat.updates"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>

</manifest>